---
const { until } = Astro.props;
---

<p data-until={until} id="until"></p>

<script>
  const element = document.getElementById("until");
  const until = element?.getAttribute("data-until");
  if (element && until) {
    const diff = new Date(until).getTime() - Date.now();
    const days = Math.round(diff / (1000 * 60 * 60 * 24));
    element.textContent = `~${days} days away`;
  }
</script>
