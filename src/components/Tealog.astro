---
import { DOMParser } from "@xmldom/xmldom";
const TEALOG_RSS_FEED = "https://jackharrhy.neocities.org/tea-log/rss.xml";
const response = await fetch(TEALOG_RSS_FEED);
if (!response.ok) throw new Error(`Tea log feed returned ${response.status}`);
const rssFeed = new DOMParser().parseFromString(await response.text(), "text/xml");
const channel = rssFeed.getElementsByTagName("channel").item(0);
if (!channel) throw new Error("Tea log feed has no channel");
const description = channel.getElementsByTagName("description").item(0)?.textContent ?? "";
const items = Array.from(channel.getElementsByTagName("item")).map((item) => ({
  title: item.getElementsByTagName("title").item(0)?.textContent ?? "",
  link: item.getElementsByTagName("link").item(0)?.textContent ?? "",
  previewGif: item.getElementsByTagName("enclosure").item(0)?.getAttribute("url") ?? "",
}));
---

<style>
  div {
    margin: 0.5rem 0;
    font-family: monospace;
    background-color: #ffadbc;
    color: rgb(36, 36, 36);
    border: 2px inset indigo;
    padding: 1rem;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  h1,
  h2,
  p,
  li,
  ul {
    padding: 0;
    margin: 0;
    font-size: 1rem;
  }

  li {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    text-decoration: underline;
    height: 1rem;
  }
  li img {
    height: 1em;
    margin-right: 0.25rem;
  }
  li:hover {
    text-decoration: indigo underline;
  }

  h1 {
    font-size: 1.2rem;
  }

  h2 {
    margin: 0.4rem 0;
    font-size: 0.8rem;
    font-weight: normal;
  }
</style>

<div id="tealog-root">
  <a href="https://jackharrhy.neocities.org/tea-log/">
    <h1>tea log</h1>
    <h2>{description}</h2>
  </a>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.link}>
            <img src={item.previewGif} alt="" />
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
